rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        isAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitorCount', 'recentVisitors'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyId', 'isFamilyOwner']) && 
         get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerId == request.auth.uid)
      );

      // Purchase & Finance
      match /transactions/{txId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
      }
      match /pending_credits/{creditId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update: if false; 
      }

      // Social Subcollections
      match /media/{mediaId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
        
        match /likes/{likerId} {
          allow read: if true;
          allow write: if request.auth != null && request.auth.uid == likerId;
        }
        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid == userId);
        }
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == followerId || isAdmin());
      }
      match /following/{followedId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Device Tokens for FCM
      match /tokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Pets and Social Assets
      match /pet/{petId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /vault/{itemId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // Game History
      match /game_history/{historyId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Writes handled by server functions
      }
      // Contributors & Ranking
      match /contributors/{contributorId} {
        allow read: if true;
      }

      // Notifications
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only server functions can write
      }
    }

    // Global Collections
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null; // Managed by functions, but basic guard
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // Live Rooms
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null; 
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      
      match /participants/{userId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      match /messages/{msgId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid ||
          resource.data.uid == request.auth.uid
        );
      }
      match /micRequests/{userId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Direct Chats
    match /chats/{chatId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants || isAdmin());
      allow update: if request.auth != null && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      match /messages/{msgId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Public Meta Data
    match /vip_tiers/{tierId} { allow read: if true; allow write: if isAdmin(); }
    match /noble_tiers/{tierId} { allow read: if true; allow write: if isAdmin(); }
    match /svip_levels/{levelId} { allow read: if true; allow write: if isAdmin(); }
    match /app_banners/{bannerId} { allow read: if true; allow write: if isAdmin(); }
    match /global_announcements/{annId} { allow read: if true; allow write: if isAdmin(); }
    match /admin_logs/{logId} { allow read, create: if isAdmin(); }
    match /prestige_items/{itemId} { allow read: if true; allow write: if isAdmin(); }
    match /system_configs/{configId} { allow read: if request.auth != null; allow write: if isAdmin(); }

    // Agencies
    match /agencies/{agencyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.ownerUid || isAdmin());
    }

    match /withdrawals/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if isAdmin();
    }

    // Salary & Revenue Distribution
    match /salaryStatus/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin(); // Only admins/functions can modify status
    }

    match /salaryPayouts/{payoutId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if request.auth != null && (isAdmin() || request.query.limit <= 100); 
      allow write: if isAdmin(); // Only admins/functions can modify payouts
    }

    // Moments (Global Feed)
    match /moments/{momentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid == get(/databases/$(database)/documents/moments/$(momentId)).data.userId);
      }
      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Families
    match /families/{familyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    match /familyJoinRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Gaming Module
    match /game_settings/{gameId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /games_meta/{gameId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /{allPaths=**} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // Rocket Global Events
    match /global_messages/{msgId} {
      allow read: if true; 
      allow write: if isAdmin(); // Only functions/admins can trigger
    }

    // Helper functions
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tags', []).hasAny(['Admin', 'SuperAdmin']);
    }
  }
}
