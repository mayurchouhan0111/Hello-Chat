rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function
    function isSuperAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == "superadmin";
    }

    match /profile_photos/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
    }

    // Future folders
    match /room_covers/{roomId} {
      allow read: if true;
      allow write: if request.auth != null; // add more logic later
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
