rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functionality
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Profiles & Social Content
    match /profile_photos/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    match /room_covers/{roomId} {
      allow read: if true;
      allow write: if isAuthenticated(); 
    }

    match /moments/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    // Admin & Global Assets
    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isAuthenticated(); // Should be restricted to admins in production
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /vip_assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
